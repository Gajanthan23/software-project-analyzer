# =============================================================================
# Software Project Complexity & Quality Analyzer — .gitignore
# =============================================================================

# ── Secrets & environment files ───────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Node.js / Frontend / Backend ─────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Python / Analyzer ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
.eggs/
*.egg
.venv/
venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
report.xml
*.mo
*.pot

# Jupyter
.ipynb_checkpoints/

# ── Machine Learning / Data ───────────────────────────────────────────────────
# Trained model files (large binaries — store in DVC or model registry)
analyzer/app/ml/models/*.pkl
analyzer/app/ml/models/*.joblib
analyzer/app/ml/models/*.h5
# Dataset files — may contain scraped data; manage separately
analyzer/app/ml/data/*.csv
analyzer/app/ml/data/*.parquet

# ── Analysis temporary workspaces ────────────────────────────────────────────
# These are created at runtime and MUST NOT be committed
/tmp/
analysis_workspace/
analyzer/tmp/

# ── PostgreSQL ───────────────────────────────────────────────────────────────
*.sql.bak
pgdata/

# ── Docker ───────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/settings.json
*.suo
*.user
.vs/

# ── Test output ──────────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/

# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
