# Maximum repository disk size limit in MB (Section 29)
MAX_REPO_SIZE_MB=500

# Analysis execution timeout limit in seconds (Section 29)
ANALYSIS_TIMEOUT_SECONDS=300

# Temporary workspace directory path for isolated repository analysis
WORKSPACE_TMP_DIR=/tmp/software-analyzer-workspaces
